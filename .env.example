# Copy this file to .env and adjust as needed. .env is gitignored.

PORT=4000
NODE_ENV=development

# Change this to a long random string before this app is ever exposed beyond your own computer.
SESSION_SECRET=dev-only-secret-change-me-before-going-live

# --- Database ---
# "local" uses the SQLite file below. "cloud" is a placeholder for later —
# see server/config/db.config.js and server/db/connection.js.
DB_MODE=local
LOCAL_DB_PATH=./data/dairy.db

# Filled in later when DB_MODE=cloud is implemented.
CLOUD_DATABASE_URL=
